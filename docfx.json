{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "src/HAModHelper.GamePlugin",
          "files": [
            "HAModHelper.GamePlugin.csproj"
          ]
        }
      ],
      "dest": "api",
      "disableGitFeatures": false
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**.yml",
          "api/index.md"
        ]
      },
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "resources/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "HAModHelper Documentation",
      "_appTitle": "HAModHelper Documentation",
      "_appLogoPath": "resources/logo.png",
      "_appFaviconPath": "resources/logo.png",
      "_enableSearch": true,
      "pdf": false
    }
  }
}